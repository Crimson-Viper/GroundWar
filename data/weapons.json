// Weapons. "accuracy" is [range in metres, chance to hit a standing man in the open] for an average shooter.
// Cover, stance, movement, suppression and skill all scale it down from there.
{
  "rifle": {
    "name": "Bolt-action rifle",
    "range": 450,
    "accuracy": [[0, 0.40], [25, 0.25], [50, 0.15], [100, 0.08], [200, 0.035], [300, 0.015], [450, 0.005]],
    "burstSize": 1,
    "spread": 1.5,
    "fireInterval": 4.0,        // seconds between aimed shots
    "fireIntervalJitter": 1.5,
    "magazineSize": 5,
    "magazines": 20,         // spare clips: 5 + 100 rounds
    "reloadTime": 4.0,
    "suppression": 10,          // fear added to a man the bullet passes close to
    "suppressionRadius": 3,     // metres around the impact that feel it
    "threat": 1.0
  },
  "lmg": {
    "name": "Light machine gun",
    "range": 600,
    "accuracy": [[0, 0.30], [25, 0.18], [50, 0.10], [100, 0.05], [200, 0.022], [300, 0.01], [600, 0.003]],
    "burstSize": 6,
    "burstInterval": 0.12,
    "spread": 2.5,
    "fireInterval": 2.5,
    "fireIntervalJitter": 1.0,
    "magazineSize": 30,
    "magazines": 12,
    "reloadTime": 6.0,
    "suppression": 9,
    "suppressionRadius": 4,
    "threat": 2.5,
    "isMachineGun": true
  },
  "atr": {
    "name": "Anti-tank rifle",
    "range": 400,
    "accuracy": [[0, 0.40], [25, 0.25], [50, 0.15], [100, 0.08], [200, 0.035], [300, 0.015], [400, 0.008]],
    "burstSize": 1,
    "spread": 1.5,
    "fireInterval": 6.0,
    "fireIntervalJitter": 1.5,
    "magazineSize": 5,
    "magazines": 6,
    "reloadTime": 5.0,
    "suppression": 12,
    "suppressionRadius": 3,
    "threat": 1.5,
    "penetration": 22,          // mm at the muzzle, half that at full range: not enough for a medium tank's armour anywhere
    "trackBreakChance": 0.15    // but a hit can still break a track and stop it
  },
  "bazooka": {
    "name": "Bazooka",
    "range": 150,
    "accuracy": [[0, 0.60], [25, 0.45], [50, 0.30], [100, 0.15], [150, 0.06]],
    "burstSize": 1,
    "spread": 2.0,
    "fireInterval": 12.0,       // loading a rocket takes the loader a while
    "fireIntervalJitter": 3.0,
    "magazineSize": 1,
    "magazines": 5,
    "reloadTime": 8.0,
    "suppression": 30,
    "suppressionRadius": 5,
    "threat": 2.0,
    "penetration": 100,         // goes through any side of a medium tank inside about 100 m
    "antiTankOnly": true,       // never fired at infantry
    "backblast": true           // everyone near the target sees where it came from
  },
  "tank_gun": {
    "name": "Tank gun (high explosive)",
    "range": 800,
    // chance the shell lands on the spot aimed at; misses land around it (see spread) and still blast
    "accuracy": [[0, 0.9], [100, 0.6], [200, 0.4], [400, 0.2], [800, 0.08]],
    "burstSize": 1,
    "spread": 6,                // metres, at 100 m; grows with range
    "fireInterval": 7.0,
    "fireIntervalJitter": 1.5,
    "magazineSize": 1,
    "magazines": 60,
    "reloadTime": 0.1,
    "suppression": 40,          // fear for men near the burst
    "suppressionRadius": 14,
    "threat": 3,
    "penetration": 50,          // a direct hit on another tank (mm at the muzzle, half that at full range)
    "blastRadius": 6            // men inside this can be killed or wounded; cover helps
  },
  "tank_mg": {
    "name": "Tank machine gun",
    "range": 600,
    "accuracy": [[0, 0.30], [25, 0.18], [50, 0.10], [100, 0.05], [200, 0.022], [300, 0.01], [600, 0.003]],
    "burstSize": 8,
    "burstInterval": 0.11,
    "spread": 2.5,
    "fireInterval": 2.5,
    "fireIntervalJitter": 1.0,
    "magazineSize": 50,
    "magazines": 30,
    "reloadTime": 5.0,
    "suppression": 9,
    "suppressionRadius": 4,
    "threat": 2.5,
    "isMachineGun": true
  }
}
