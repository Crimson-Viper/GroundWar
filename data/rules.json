    "movingTargetFactor": 0.5, "shakenAccuracy": 0.8,
    "suppressionAccuracyLoss": 0.75, "coverSuppressionShield": 0.3
  },
  "morale": {
    "shakenBelow": 50, "pinnedBelow": 32, "brokenBelow": 18, "rallyAbove": 40, "rallySafeDistance": 80,
    "suppressionShaken": 35, "suppressionPinned": 55, "suppressionNoFire": 80, "suppressionMax": 100,
    "suppressionDecayDelay": 2, "suppressionDecayPerSecond": 8,
    "nearMissMoralePerSuppression": 0.05,
    "friendKilled": 12, "friendWounded": 7, "friendRadius": 25,
    "leaderKilled": 15, "leaderShockWindow": 30, "enemyDownSeen": 3,
    "tankFearPerSecond": 0.3, "tankFearRange": 100,
    "groupBrokenFraction": 0.5, "groupBrokenShock": 12,
    "recoverPerSecond": 0.4, "recoverInCoverPerSecond": 0.3, "recoverLeaderNearbyPerSecond": 0.3,
    "leaderRadius": 25, "aloneDrainPerSecond": 0.3, "aloneRadius": 15, "noAmmoDrainPerSecond": 0.5, "quietSuppression": 10
  },
  "ai": {
    "thinkInterval": 0.4,
    "coverSearchRadius": 25, "suppressedCoverSearchRadius": 8,
    "stickinessBonus": 10, "underFireWindow": 5, "digTime": 90, "digQuietTime": 10, "mapEdgeRoutDistance": 4
  },
  "squad": {
    "thinkInterval": 1.5,        // seconds between squad leader decisions
    "travelStep": 40,            // metres per leg when no enemy is expected
    "boundStep": 30,             // metres per bound in bounding overwatch
    "deadGroundBonus": 0.5,      // how much a squad prefers to end a bound out of the enemy's sight (cover scores up to 1.2)
    "rushStep": 22,              // metres per rush under fire
    "teamRadius": 9,             // how spread out a team settles at its destination
    "maxBoundTime": 40,
    "boundingRange": 150,        // start bounding this close to the objective or known enemy
    "contactRange": 350,         // known enemy closer than this makes the squad fight, not travel
    "planRange": 140,            // attackers close in by bounds to this range, then plan a flank
    "quietEndTime": 60,          // battle ends when nobody is attacking and nobody has fired for this long
    "flankOffset": 50,           // how far to the side of the enemy the flanking team aims
    "flankSideStep": 45,         // first leg of the flank goes this far sideways
    "assaultRange": 60,          // rifle team assaults from this close
    "liftFireRange": 25,         // gun team stops firing when the assault gets this close
    "enemyQuietTime": 4,         // no incoming fire for this long = enemy is suppressed
    "pinnedAbortTime": 20,       // flank given up if the rifle team is pinned this long
    "fallBackStrength": 0.4,     // defenders fall back below this share of their men
    "fallBackStep": 40,
    "shareRadius": 80,           // squads this close share what they've seen
    "areaFireAccuracy": 0.3,     // firing at where the enemy was seen, not at a man
    "friendlyFireSafety": 8      // never fire where a friend is this close to the aim point
  },
  "comms": {
    "phoneDelay": 12, "phoneDelayJitter": 5,  // seconds for a telephone message
    "phoneReach": 25,            // a squad can use the phone if its sergeant is this close to the line's end
    "lineCutRadius": 3,          // a shell bursting this close to a cable cuts it
    "radioDelay": 30, "radioDelayJitter": 10, // coding, sending, decoding
    "radioRepeatChance": 0.15,   // chance a radio message has to be sent again (double delay)
    "flareDelay": 6,             // flare up to squad acting on it (halt and fall back only)
    "flareRange": 1500,
    "runnerSpeed": 3,            // metres a second
    "runnerDangerRange": 250,    // enemies who can see a runner this close may shoot him
    "runnerHitPerSecond": 0.004, // per enemy that can see him (and isn't pinned), at point blank
    "runnerLostResend": 60,      // HQ sends a lost order again this long after the runner was shot
    "sitrepInterval": 30,        // squads in contact report this often
    "hqContactMemory": 120,      // HQ forgets a sighting this long after it was made
    "playerSeesReportsOnly": true, // you see the enemy only as reports reach your HQ
    "voiceRange": 60, "voiceDelay": 3,        // inside a company: a sergeant this close just shouts
    "companyRadioDelay": 10, "companyRadioDelayJitter": 4, // the company's own short-range radio net
    "companySitrepInterval": 60, // a company commander reports to battalion this often
    "briefBackWait": 10,         // a brief-back plan starts this long after HQ hears it, unless you step in
    "briefBackReplyDelay": 5     // HQ's "approved" / "rejected" to a commander waiting on the radio
  },
  "company": {
    "deathTrapLoss": 0.35,       // expected loss (fraction of the company) that makes a plan a death trap
    "deathTrapSuccess": 0.3,     // so does a chance of success below this
    "assumedEnemyFire": 6,       // fire he assumes on an objective he knows nothing about (+2 per point of caution)
    "exposureLethality": 0.00045, // how deadly a second under one point of enemy fire is
    "startLineDistance": 170, "supportDistance": 130, "flankWidth": 70,
    "establishFireTime": 20,     // seconds of covering fire before the flankers go in
    "hqBehind": 60,              // the company HQ keeps this far behind its squads
    "replanLoss": 0.35,          // losing this much of the company makes him think again
    "maxReplans": 2
  },
  "support": {
    "setUpTime": 12,             // seconds to lay the mortars on a new target
    "roundInterval": 5,          // seconds between rounds from one tube
    "flightTime": 8, "flightSpeed": 150, // time of flight: 8 s plus 1 s per 150 m
    "firstSpread": 30,           // metres: where the first rounds land around the target (one standard deviation)
    "adjustedSpread": 14,        // once the fall of shot has been corrected
    "minRange": 80, "maxRange": 2500,
    "crewPerTube": 2,
    "smokeRadius": 14,           // one smoke round's cloud
    "smokeDuration": 75,         // seconds it hides things
    "smokeGrowTime": 6,
    "wind": [0.4, 0.15],         // metres per second; smoke drifts with it
    "prepRounds": 9, "smokeRounds": 6, "quickRounds": 4, // rounds a commander asks for
    "requestCooldown": 90,       // a commander waits this long before asking again for the same area
    "dangerClose": 60,           // he won't call fire this close to his own men
    "defensiveFireRange": 350,   // a defending commander fires on attackers this close
    "artilleryCallDelay": 25,    // battalion's radio call to the guns off the map
    "artillerySetUpTime": 20, "artilleryRoundInterval": 8, "artilleryFlightTime": 25,
    "artilleryFirstSpread": 55, "artilleryAdjustedSpread": 28,
    "artilleryRounds": 8         // rounds in one of battalion's artillery missions
  },
  "battalion": {
    "thinkInterval": 20,         // seconds between a battalion commander's looks at the battle
    "hqCaptureRadius": 30,       // enemy within this of an HQ, and none of its own men...
    "hqCaptureTime": 15,         // ...for this long: the HQ is destroyed
    "freshStrength": 0.55,       // a company this fit can attack
    "spentStrength": 0.3,        // below this it just holds
    "retryDelay": 180,           // seconds before trying a place again after a failed attack
    "refusalWait": 120,          // seconds before insisting on (or giving up) an order a company refused
    "attackTimeLimit": 900,      // an attack not done by then counts as failed
    "keyPointRange": 40,         // enemy this close to a key point are "at" it
    "hqThreatRange": 350,        // enemy this close to a defender's HQ bring his reserve back to guard it
    "artilleryCooldown": 120, "artilleryMinTargets": 5, "artilleryDangerClose": 110,
    "contactAge": 90             // sightings older than this are too stale to act on
  },
  "terrain": {                   // hills, woods, hedgerows and crops: see docs/systems/terrain.md
    "treeHeight": 8,             // a line of sight that passes above this clears a wood
    "woodsSightDepth": 30,       // metres of woodland you can see through
    "treeCoverDistance": 1.5,    // a trunk this close, on the side the fire comes from, is cover
    "woodsProtection": 0.2, "treeProtection": 0.6, "hedgeProtection": 0.4,
    "hedgePeerDistance": 2.5,    // a man this close to a hedgerow sees (and is seen) through it
    "hedgeSpeedFactor": 0.3, "woodsSpeedFactor": 0.8, "cropsSpeedFactor": 0.9,
    "uphillSlowdown": 3,         // speed is divided by 1 + this x the slope (a 1-in-5 climb: 1.6 times slower)
    "woodsConcealment": 0.5, "hedgeConcealment": 0.4,              // chance-to-spot multipliers (1 = no help)
    "cropsProneConcealment": 0.2, "cropsCrouchedConcealment": 0.5,
    "cropsProneViewRange": 12,   // a man flat in the wheat sees no further than this
    "highGroundBonus": 0.15      // per metre: how much a commander likes higher ground for covering fire and defence
  }
}
