<Project Sdk="Microsoft.NET.Sdk">
  <!-- The battle simulation. Plain C#, no Godot code, so it can run headless and be ported. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>GroundWar.Sim</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
