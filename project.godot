; Ground War prototype. Open this file from the Godot project manager (Import).

config_version=5

[application]

config/name="Ground War"
config/description="RTS prototype: you give orders, AI commanders and soldiers fight the battle."
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="GroundWar"

[rendering]

anti_aliasing/quality/msaa_3d=2
